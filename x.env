# Copy this file to .env and fill in your OWN, freshly-rotated key.
# Never commit .env, never paste your key into chat, client-side code, or a public repo.

# Get a new key at https://console.x.ai/team/default/api-keys
# (Rotate/revoke the previously exposed key first — treat it as compromised.)
XAI_API_KEY=

# Get a key at https://console.anthropic.com/settings/keys
# This is a NEW requirement: text generation (plot/characters/map/script) now
# runs through this backend too, since calling api.anthropic.com directly
# from a plain browser (outside Claude's own in-app preview) has no valid
# credentials and fails immediately.
ANTHROPIC_API_KEY=

# Only needed if your key is an "identity-linked" key (Anthropic will reject
# requests with "anthropic-workspace-id is required..." if so). Find your
# workspace ID (format: wrkspc_...) at https://console.anthropic.com under
# Settings > Workspaces, or via the Admin API. Leave blank if not needed.
ANTHROPIC_WORKSPACE_ID=

# Port this server listens on
PORT=3001

# Which xAI video model to use. Check https://docs.x.ai for the current model name.
XAI_VIDEO_MODEL=grok-imagine-video

# Requested resolution for "low resolution" output.
# NOTE: xAI's docs examples only show "720p" explicitly. "480p" is used here as a
# best-effort "low resolution" default — verify the current allowed values in
# https://docs.x.ai/developers/rest-api-reference/inference/videos and adjust if
# the API rejects it.
XAI_VIDEO_RESOLUTION=480p

# Duration in seconds requested per clip (per the 2-prompts-per-scene design, 14s each)
XAI_VIDEO_DURATION=14

# Comma-separated list of origins allowed to call this backend (your front-end's origin).
# Use "*" only for local testing — lock this down before sharing the app publicly.
ALLOWED_ORIGINS=*

# How often (ms) to poll xAI for each clip's status
POLL_INTERVAL_MS=5000

# Max time (ms) to wait for a single clip before giving up
POLL_TIMEOUT_MS=300000
